---
import Layout from "@/layouts/Layout.astro";
import TextReveal from "@/components/ui/TextReveal";
import FadeContent from "@/components/ui/FadeContent";
import SpotlightCard from "@/components/ui/SpotlightCard";
import { SITE_CONFIG } from "@/config";
import { getCollection } from "astro:content";
import { RiArrowRightUpLine } from "@remixicon/react";

const items = await getCollection("selection");
const totalCount = items.length;
const hasAffiliate = items.some((item) => item.data.affilie);

// Rubriques : d'abord l'ordre de config.ts, puis les autres par ordre d'apparition
const order = SITE_CONFIG.selection.categories;
const byCategory = new Map<string, typeof items>();
for (const name of order) byCategory.set(name, []);
for (const item of items) {
    if (!byCategory.has(item.data.categorie)) byCategory.set(item.data.categorie, []);
    byCategory.get(item.data.categorie)!.push(item);
}
const sections = [...byCategory.entries()].filter(([, list]) => list.length > 0);
const slug = (s: string) =>
    s.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
---

<Layout
    title={`MA SÉLECTION // ${SITE_CONFIG.title}`}
    description="Le matériel que j'utilise et les livres que j'ai lus."
>
    <div class="max-w-6xl mx-auto w-full pt-2 sm:pt-4 md:pt-8 pb-16 sm:pb-20">
        <div class="hidden md:flex fixed top-0 right-0 h-screen z-[-10] select-none pointer-events-none overflow-hidden items-center justify-center">
            <TextReveal
                client:load
                text="Sélection"
                type="char"
                className="font-bold text-black/[0.03] dark:text-white/[0.10] text-[8vh] sm:text-[10vh] lg:text-[18vh] leading-none whitespace-nowrap"
                style={{ writingMode: "vertical-rl", textOrientation: "mixed" }}
            />
        </div>

        <header class="mb-8 sm:mb-10 md:mb-12 pb-5 border-b border-black/5 dark:border-white/5 flex flex-col md:flex-row md:items-end justify-between gap-4 md:gap-8">
            <div class="shrink-0">
                <div class="flex items-center gap-2 mb-2 sm:mb-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-black/40 dark:bg-white/40"></span>
                    <span class="font-mono text-[10px] sm:text-xs uppercase tracking-widest text-secondary-text">
                        Matériel & lectures
                    </span>
                </div>
                <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-normal leading-tight tracking-tight text-primary-text">
                    Ma sélection.
                </h1>
            </div>
            <div class="max-w-md md:text-right flex flex-col md:items-end gap-2 pb-0.5">
                <p class="text-[13px] sm:text-sm font-light leading-relaxed text-secondary-text dark:text-gray-400">
                    Le matériel que j'utilise vraiment et les livres qui m'ont marqué.
                </p>
                <div class="text-[10px] sm:text-[11px] font-mono text-secondary-text/70 dark:text-zinc-400 uppercase tracking-widest">
                    // {totalCount} {totalCount <= 1 ? "RECOMMANDATION" : "RECOMMANDATIONS"}
                </div>
            </div>
        </header>

        {
            sections.length > 1 && (
                <nav class="flex flex-wrap gap-x-5 gap-y-2 mb-10 font-mono text-[11px] uppercase tracking-widest" aria-label="Rubriques">
                    {sections.map(([name]) => (
                        <a href={`#${slug(name)}`} class="text-secondary-text hover:text-primary-text transition-colors">
                            {name}
                        </a>
                    ))}
                </nav>
            )
        }

        {
            hasAffiliate && (
                <p class="mb-10 max-w-3xl text-xs sm:text-[13px] font-light leading-relaxed text-secondary-text dark:text-zinc-400 border-l-2 border-black/10 dark:border-white/15 pl-4">
                    Certains liens de cette page sont des liens affiliés, signalés par la mention « lien affilié ». Si vous achetez
                    via ces liens, je touche une petite commission, sans surcoût pour vous.
                    {SITE_CONFIG.selection.partenaireAmazon && " En tant que Partenaire Amazon, je réalise un bénéfice sur les achats remplissant les conditions requises."}
                </p>
            )
        }

        {
            sections.length === 0 && (
                <div class="py-16 text-center text-secondary-text/60 font-mono text-xs uppercase tracking-widest">
                    // SÉLECTION EN PRÉPARATION
                </div>
            )
        }

        <div class="flex flex-col gap-14 sm:gap-16">
            {
                sections.map(([name, list]) => (
                    <section id={slug(name)} class="scroll-mt-32">
                        <h2 class="flex items-baseline justify-between gap-4 mb-5 sm:mb-6 pb-2 border-b border-black/5 dark:border-white/10">
                            <span class="text-lg sm:text-xl font-medium tracking-tight text-primary-text">{name}</span>
                            <span class="font-mono text-[11px] text-secondary-text/70 tabular-nums">
                                {String(list.length).padStart(2, "0")}
                            </span>
                        </h2>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
                            {list.map((item, index) => (
                                <FadeContent client:visible delay={index * 50} duration={500} blur={true} className="h-full">
                                    <SpotlightCard
                                        client:visible
                                        className="h-full p-3 sm:p-4 relative group flex flex-col gap-3 border border-transparent dark:border-white/[0.08] dark:hover:border-white/20 dark:bg-white/[0.015] dark:hover:bg-white/[0.035] transition-all duration-300"
                                    >
                                        <a
                                            href={item.data.lien}
                                            target="_blank"
                                            rel={item.data.affilie ? "sponsored nofollow noopener noreferrer" : "noopener noreferrer"}
                                            class="absolute inset-0 z-20 cursor-pointer rounded-xl"
                                            aria-label={`${item.data.nom}${item.data.affilie ? " (lien affilié)" : ""}`}
                                        />
                                        {item.data.image && (
                                            <div class="aspect-[4/3] w-full rounded-lg overflow-hidden bg-white flex items-center justify-center relative z-10 pointer-events-none">
                                                <img
                                                    src={item.data.image}
                                                    alt={item.data.nom}
                                                    loading="lazy"
                                                    decoding="async"
                                                    class="w-full h-full object-contain p-3 transition-transform duration-500 group-hover:scale-105"
                                                />
                                            </div>
                                        )}
                                        <div class="flex items-start justify-between gap-3 relative z-10 pointer-events-none">
                                            <div class="min-w-0">
                                                <h3 class="text-sm sm:text-[15px] font-medium tracking-wide text-primary-text dark:text-white">
                                                    {item.data.nom}
                                                </h3>
                                                {item.data.detail && (
                                                    <p class="font-mono text-[11px] text-secondary-text dark:text-zinc-400 mt-0.5">
                                                        {item.data.detail}
                                                    </p>
                                                )}
                                            </div>
                                            <RiArrowRightUpLine
                                                size={16}
                                                className="shrink-0 mt-0.5 text-secondary-text/60 dark:text-zinc-400 group-hover:text-black dark:group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-300"
                                            />
                                        </div>
                                        {item.data.avis && (
                                            <p class="text-[13px] font-light leading-relaxed text-secondary-text dark:text-zinc-300 relative z-10 pointer-events-none">
                                                {item.data.avis}
                                            </p>
                                        )}
                                        {item.data.affilie && (
                                            <span class="mt-auto self-start font-mono text-[10px] uppercase tracking-widest text-secondary-text/70 dark:text-zinc-400 relative z-10 pointer-events-none">
                                                Lien affilié
                                            </span>
                                        )}
                                    </SpotlightCard>
                                </FadeContent>
                            ))}
                        </div>
                    </section>
                ))
            }
        </div>
    </div>
</Layout>
