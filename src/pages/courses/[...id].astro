---
import Layout from "@/layouts/Layout.astro";
import { SITE_CONFIG } from "@/config";
import { getCollection, render, type CollectionEntry } from "astro:content";
import CityRoadMap from "@/components/courses/CityRoadMap";
import { RiArrowLeftLine } from "@remixicon/react";
import TextReveal from "@/components/ui/TextReveal";
import { courseStats, formatDateFr } from "@/utils/courses";
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
    const courses = await getCollection("courses");
    return courses.map((course) => ({
        params: { id: course.id },
        props: { course },
    }));
}

const { course } = Astro.props as { course: CollectionEntry<"courses"> };
const { Content } = await render(course);
const d = course.data;
const dateStr = formatDateFr(d.date);
const facts = [
    { label: "Date", value: dateStr },
    { label: "Sport", value: d.sport },
    { label: "Lieu", value: d.lieu },
    ...courseStats(d),
    ...(d.classement ? [{ label: "Classement", value: d.classement }] : []),
    ...(d.classementCategorie ? [{ label: "Catégorie", value: d.classementCategorie }] : []),
];
const viewName = course.id.replace(/[^a-zA-Z0-9_-]/g, "-");
---

<Layout
    title={`${d.nom} // ${SITE_CONFIG.title}`}
    description={`${d.nom} — ${d.sport}, ${d.lieu}, ${dateStr}`}
>
    {/* Ambient Background Map */}
    <div
        class="fixed inset-0 z-0 pointer-events-none opacity-10 dark:opacity-[0.18] map-blend transition-opacity duration-1000"
        style="mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 40%, transparent 85%); -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 40%, transparent 85%);"
    >
        <CityRoadMap
            client:load
            siteName={d.lieu}
            coordinates={d.coordonnees}
            className="w-full h-full object-cover sm:object-contain"
        />
    </div>

    <!-- Background Reveal Watermark -->
    <div
        class="hidden md:flex fixed top-0 right-0 h-screen z-[-10] select-none pointer-events-none overflow-hidden items-center justify-center"
    >
        <TextReveal
            client:load
            text="Course"
            type="char"
            className="font-bold text-black/[0.03] dark:text-white/[0.10] text-[8vh] sm:text-[10vh] lg:text-[18vh] leading-none whitespace-nowrap"
            style={{
                writingMode: "vertical-rl",
                textOrientation: "mixed",
            }}
        />
    </div>

    <article
        class="font-sans relative z-10 pt-1 sm:pt-2 md:pt-4 pb-24 max-w-6xl mx-auto w-full flex flex-col md:flex-row gap-8 md:gap-12 lg:gap-16 items-start"
        data-pagefind-body
    >
        {/* Left Column: Navigation & Telemetry Docket (Comfortable width, zero line-wrapping) */}
        <aside
            data-pagefind-ignore
            class="w-full md:w-48 lg:w-52 xl:w-56 flex-shrink-0 flex flex-col md:sticky md:top-36 md:self-start"
        >
            <a
                href={`/courses?annee=${d.date.getUTCFullYear()}&id=${course.id}`}
                class="inline-flex items-center gap-2 text-xs font-mono tracking-widest text-secondary-text dark:text-zinc-300 hover:text-primary-text dark:hover:text-white transition-all duration-300 uppercase opacity-85 dark:opacity-100 group"
            >
                <RiArrowLeftLine
                    className="w-3.5 h-3.5 transition-transform duration-300 group-hover:-translate-x-1"
                />
                <span>TOUTES LES COURSES</span>
            </a>

            {/* Fiche de la course */}
            <dl class="hidden md:flex flex-col gap-5 font-mono pt-6 mt-6 border-t border-black/5 dark:border-white/5">
                {facts.map((f) => (
                    <div class="flex flex-col gap-1.5">
                        <dt class="text-[10px] uppercase tracking-widest text-secondary-text/70 dark:text-zinc-400">{f.label}</dt>
                        <dd class="text-xs text-primary-text dark:text-zinc-200 tracking-wide font-medium">{f.value}</dd>
                    </div>
                ))}
            </dl>
        </aside>

        {/* Right Column: Main Content Stream (Aligns directly with index content stream) */}
        <main
            class="flex-1 w-full min-w-0 pt-0"
        >
            {/* Header: Site Eyebrow + Title */}
            <header class="mb-8 md:mb-10">
                <div class="flex items-center gap-2 mb-2 sm:mb-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-black/40 dark:bg-white/40"></span>
                    <span class="font-mono text-[10px] sm:text-xs uppercase tracking-widest text-secondary-text dark:text-zinc-400">
                        {d.sport} · {d.lieu}
                    </span>
                </div>

                <h1
                    data-pagefind-meta="title"
                    class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-medium tracking-tight text-primary-text leading-tight"
                    style={`view-transition-name: course-title-${viewName}`}
                >
                    {d.nom}
                </h1>
            </header>

            {/* Fiche (mobile) */}
            <dl data-pagefind-ignore class="grid grid-cols-2 gap-x-6 gap-y-3 md:hidden mb-8 pb-4 border-b border-black/5 dark:border-white/10 font-mono">
                {facts.map((f) => (
                    <div class="flex flex-col gap-0.5">
                        <dt class="text-[10px] uppercase tracking-widest text-secondary-text/70 dark:text-zinc-400">{f.label}</dt>
                        <dd class="text-[12px] text-primary-text dark:text-zinc-200 font-medium">{f.value}</dd>
                    </div>
                ))}
            </dl>

            {/* Prose Content */}
            <div
                class="prose dark:prose-invert max-w-2xl lg:max-w-3xl prose-headings:font-sans prose-headings:font-medium prose-headings:tracking-tight prose-a:text-black dark:prose-a:text-white prose-a:underline prose-a:decoration-1 prose-a:underline-offset-4 prose-blockquote:not-italic prose-blockquote:border-l-2 prose-blockquote:pl-6 prose-blockquote:border-black/20 dark:prose-blockquote:border-white/20 prose-p:font-light prose-p:opacity-90 prose-p:tracking-wide prose-p:leading-relaxed prose-p:text-[15px] sm:prose-p:text-base prose-img:rounded-xl"
            >
                <Content />
            </div>

            {/* Tags */}
            {d.tags && d.tags.length > 0 && (
                <div class="mt-12 flex flex-wrap gap-2 not-prose">
                    {d.tags.map((tag: string) => (
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-black/[0.04] dark:bg-white/[0.08] hover:dark:bg-white/[0.12] rounded-full text-xs font-mono text-secondary-text dark:text-zinc-200 border border-black/5 dark:border-white/10 transition-colors">
                            <span class="text-secondary-text/50 dark:text-zinc-400">#</span>
                            <span class="font-medium tracking-wide">{tag}</span>
                        </span>
                    ))}
                </div>
            )}

            {/* Colophon / End of Log */}
            <div class="mt-16 sm:mt-20 pt-6 border-t border-black/5 dark:border-white/10 flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono text-secondary-text/75 dark:text-zinc-400 uppercase tracking-widest">
                <span>{dateStr}</span>
                <span class="text-[10px] text-secondary-text/65 dark:text-zinc-400">CARTE // © OPENSTREETMAP</span>
                <span>// FIN</span>
            </div>
        </main>
    </article>
</Layout>

<style is:global>
    /* Simple image wrapper without background/card effects */
    .traces-image-wrapper {
        margin-top: 3.5rem;
        margin-bottom: 3.5rem;
        border-radius: 1rem;
        overflow: hidden;
    }
</style>
