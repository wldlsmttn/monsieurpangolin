---
import Layout from "@/layouts/Layout.astro";
import { SITE_CONFIG } from "@/config";
import { getCollection } from "astro:content";
import CoursesExplorer, { type CourseYear } from "@/components/courses/CoursesExplorer";
import TextReveal from "@/components/ui/TextReveal";
import { toCourseSummary } from "@/utils/courses";

const allCourses = (await getCollection("courses")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const totalCount = allCourses.length;
const totalKm = allCourses.reduce((sum, c) => sum + (c.data.distance || 0), 0);

// Group by year, most recent first
const byYear = new Map<number, typeof allCourses>();
for (const course of allCourses) {
    const year = course.data.date.getUTCFullYear();
    if (!byYear.has(year)) byYear.set(year, []);
    byYear.get(year)!.push(course);
}
const courseYears: CourseYear[] = [...byYear.entries()]
    .sort(([a], [b]) => b - a)
    .map(([year, entries]) => ({ year, courses: entries.map(toCourseSummary) }));
---

<Layout
    title={`COURSES // ${SITE_CONFIG.title}`}
    description="Mes courses : récits, photos et résultats."
>
    <div
        class="max-w-6xl mx-auto w-full pt-1 sm:pt-2 md:pt-4 pb-16 sm:pb-20"
    >
        <!-- Background Reveal Watermark -->
        <div
            class="hidden md:flex fixed top-0 right-0 h-screen z-[-10] select-none pointer-events-none overflow-hidden items-center justify-center"
        >
            <TextReveal
                client:load
                text="Courses"
                type="char"
                className="font-bold text-black/[0.03] dark:text-white/[0.10] text-[8vh] sm:text-[10vh] lg:text-[18vh] leading-none whitespace-nowrap"
                style={{
                    writingMode:
                        "vertical-rl",
                    textOrientation:
                        "mixed",
                }}
            />
        </div>

        <!-- Editorial Left-Right Header (Preserves rich narrative while eliminating Y-axis space waste) -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 md:gap-10 mb-8 md:mb-12">
            <!-- Left Column: Status Eyebrow + Large Serif Title -->
            <div class="shrink-0">
                <div class="flex items-center gap-2 mb-2 sm:mb-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-black/40 dark:bg-white/40"></span>
                    <span class="font-mono text-[10px] sm:text-xs uppercase tracking-widest text-secondary-text">
                        Dossards & récits
                    </span>
                </div>
                <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal leading-tight tracking-tight text-primary-text">
                    Courses.
                </h1>
            </div>

            <!-- Right Column: Description Paragraph + Status Counter -->
            <div class="max-w-md md:text-right flex flex-col md:items-end gap-2 pb-0.5">
                <p class="text-[13px] sm:text-sm font-light leading-relaxed text-secondary-text dark:text-gray-400">
                    Course à pied, trail, triathlon… Le récit, les photos et les chiffres de chaque course.
                </p>
                <div class="text-[10px] sm:text-[11px] font-mono text-secondary-text/70 dark:text-zinc-400 uppercase tracking-widest">
                    // {totalCount} {totalCount <= 1 ? 'COURSE' : 'COURSES'}{totalKm > 0 && ` · ${new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 }).format(totalKm)} KM`}
                </div>
            </div>
        </div>

        <CoursesExplorer client:load data={courseYears} />
    </div>
</Layout>
